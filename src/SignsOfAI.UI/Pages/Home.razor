@page "/"
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@using SignsOfAI.Core
@using SignsOfAI.Core.Documents
@using SignsOfAI.Core.Model
@using SignsOfAI.Core.Rules
@inherits LocalizedComponent
@inject AiWritingAnalyzer Analyzer
@inject HumanizerService Humanizer
@inject BrowserStorage Storage
@inject CatalogStore Catalogs
@inject IDocumentReader Reader
@inject HostCapabilities Host
@inject IJSRuntime JS

<PageTitle>@L["home.pagetitle"]</PageTitle>

<header class="hero">
    <p class="tagline">@L.M("home.tagline")</p>
    <p class="privacy"><Icon Name="lock" /> @L["home.privacy"]</p>
</header>

<section class="editor card">
    <div class="toolbar">
        <label class="field">
            @L["home.textlang"]
            <select @bind="_language" @bind:after="OnControlChanged">
                <option value="auto">@L["home.textlang.auto"]</option>
                <option value="en">@L["lang.english"]</option>
                <option value="es">@L["lang.spanish"]</option>
            </select>
        </label>
        <label class="upload-btn" title="@L["common.upload.title"]">
            <Icon Name="upload" /> @L["home.upload"]
            <InputFile OnChange="OnFileSelected" accept="@Reader.Accept" />
        </label>
        <div class="samples">
            <span>@L["home.samples"]</span>
            <button class="link" @onclick="@(() => LoadSample(SampleEn))">@L["home.sample.en"]</button>
            <button class="link" @onclick="@(() => LoadSample(SampleEs))">@L["home.sample.es"]</button>
            <button class="link" @onclick="@(() => LoadSample(SampleHuman))">@L["home.sample.human"]</button>
        </div>
        <span class="live-pill" title="@L["home.live.title"]"><span class="live-dot"></span> @L["home.live"]</span>
        <div class="counter">@WordCount @L["common.words"]</div>
    </div>

    @if (_fileNote is not null) { <p class="file-note">@_fileNote</p> }

    <textarea @bind="_text" @bind:event="oninput" @bind:after="OnTextChanged"
              placeholder="@L["home.editor.placeholder"]"
              spellcheck="false"></textarea>
    <p class="hint doc-hint">@L.M(Reader.HintKey)</p>

    <div class="actions">
        <button class="ghost" @onclick="Clear" disabled="@string.IsNullOrEmpty(_text)">@L["common.clear"]</button>
        <button class="ghost" @onclick="@(() => _showCatalogs = !_showCatalogs)">
            <Icon Name="layers" /> @L["home.catalogs"]@(Catalogs.Catalogs.Count > 0 ? $" ({Catalogs.Catalogs.Count})" : "")
        </button>
        <button class="ghost settings-toggle" @onclick="@(() => _showSettings = !_showSettings)"><Icon Name="settings" /> @L["home.provider.btn"]</button>
    </div>

    @if (_showCatalogs)
    {
        <div class="settings">
            <p class="hint">@L.M("home.byoc")</p>

            <div class="catalog-list">
                <div class="catalog-row builtin"><span><Icon Name="check" /> @L["home.builtin.en"]</span></div>
                <div class="catalog-row builtin"><span><Icon Name="check" /> @L["home.builtin.es"]</span></div>
                @foreach (var c in Catalogs.Catalogs)
                {
                    <div class="catalog-row">
                        <label class="cat-toggle">
                            <input type="checkbox" checked="@c.Enabled" @onchange="@(() => ToggleCatalog(c))" />
                            <span>@c.Name</span>
                        </label>
                        <span class="cat-meta">@L.P(c.RuleCount, "home.rules") · @(c.Language == "*" ? L["home.anylang"] : c.Language)</span>
                        <button class="link danger" @onclick="@(() => RemoveCatalog(c))">@L["common.remove"]</button>
                    </div>
                }
            </div>

            <div class="catalog-add">
                <div class="add-tabs">
                    <button class="filter @(_catMode == "words" ? "on" : "")" @onclick="@(() => _catMode = "words")">@L["home.cat.mode.words"]</button>
                    <button class="filter @(_catMode == "json" ? "on" : "")" @onclick="@(() => _catMode = "json")">@L["home.cat.mode.json"]</button>
                </div>

                @if (_catMode == "words")
                {
                    <input placeholder="@L["home.cat.name.ph"]" @bind="_newCatName" @bind:event="oninput" />
                    <textarea class="cat-words" placeholder="@L["home.cat.words.ph"]" @bind="_newCatWords" @bind:event="oninput"></textarea>
                    <button class="primary" @onclick="AddBannedWords" disabled="@string.IsNullOrWhiteSpace(_newCatWords)">@L["home.cat.add"]</button>
                }
                else
                {
                    <input placeholder="@L["home.cat.name.ph2"]" @bind="_newCatName" @bind:event="oninput" />
                    <textarea class="cat-words mono" placeholder='{ "language": "*", "lexical": [ { "id": "x", "terms": ["foo"], "suggestion": "bar" } ], "patterns": [] }' @bind="_newCatJson" @bind:event="oninput"></textarea>
                    @if (_catError is not null) { <p class="hint danger-text">@_catError</p> }
                    <div class="key-row">
                        <button class="primary" @onclick="AddJsonCatalog" disabled="@string.IsNullOrWhiteSpace(_newCatJson)">@L["home.cat.import"]</button>
                        <button class="ghost" @onclick="DownloadTemplate">@L["home.cat.template"]</button>
                    </div>
                }
            </div>
        </div>
    }

    @if (_showSettings)
    {
        <div class="settings">
            <p class="hint">@L["home.settings.hint"]</p>
            <label class="field">
                @L["home.provider.label"]
                <select @bind="_settings.Provider">
                    <option value="@AiProvider.Anthropic">Anthropic (Claude)</option>
                    <option value="@AiProvider.OpenAI">OpenAI</option>
                    <option value="@AiProvider.AzureOpenAI">Azure OpenAI</option>
                    <option value="@AiProvider.DeepSeek">DeepSeek</option>
                    <option value="@AiProvider.Ollama">@L["home.provider.local"]</option>
                </select>
            </label>

            @switch (_settings.Provider)
            {
                case AiProvider.Anthropic:
                    <div class="key-row">
                        <input type="password" placeholder="sk-ant-…" @bind="_settings.ApiKey" @bind:event="oninput" />
                    </div>
                    <p class="hint sub">@L.M("home.hint.anthropic")</p>
                    break;

                case AiProvider.OpenAI:
                    <div class="azure-grid">
                        <input placeholder="@L["home.ph.model"]" @bind="_settings.Model" @bind:event="oninput" />
                        <input type="password" placeholder="@L["home.ph.key"]" @bind="_settings.ApiKey" @bind:event="oninput" />
                    </div>
                    <p class="hint sub">@L.M("home.hint.openai")</p>
                    break;

                case AiProvider.AzureOpenAI:
                    <div class="azure-grid">
                        <input placeholder="@L["home.ph.azure.endpoint"]" @bind="_settings.AzureEndpoint" @bind:event="oninput" />
                        <input placeholder="@L["home.ph.azure.deployment"]" @bind="_settings.AzureDeployment" @bind:event="oninput" />
                        <input placeholder="@L["home.ph.azure.version"]" @bind="_settings.AzureApiVersion" @bind:event="oninput" />
                        <input type="password" placeholder="@L["home.ph.key.plain"]" @bind="_settings.ApiKey" @bind:event="oninput" />
                    </div>
                    <p class="hint sub">@L.M("home.hint.azure")</p>
                    break;

                case AiProvider.DeepSeek:
                    <div class="azure-grid">
                        <input placeholder="@L["home.ph.model.deepseek"]" @bind="_settings.Model" @bind:event="oninput" />
                        <input type="password" placeholder="@L["home.ph.key"]" @bind="_settings.ApiKey" @bind:event="oninput" />
                    </div>
                    <p class="hint sub">@L.M("home.hint.deepseek")</p>
                    break;

                case AiProvider.Ollama:
                    <div class="azure-grid">
                        <input placeholder="@L["home.ph.ollama.base"]" @bind="_settings.OllamaBaseUrl" @bind:event="oninput" />
                        @* A free-text model name is a guess the user only finds out was wrong when
                           the rewrite fails. Ask Ollama what it has instead. *@
                        <input list="ollama-models" placeholder="@L["home.ph.model.ollama"]"
                               @bind="_settings.Model" @bind:event="oninput" />
                        <datalist id="ollama-models">
                            @foreach (var m in _ollamaModels)
                            {
                                <option value="@m"></option>
                            }
                        </datalist>
                    </div>
                    <div class="key-row">
                        <button class="ghost" @onclick="DetectOllamaModels" disabled="@_ollamaBusy">
                            <Icon Name="refresh" /> @L[_ollamaBusy ? "home.ollama.detecting" : "home.ollama.detect"]
                        </button>
                        @if (_ollamaNote is not null)
                        {
                            <span class="hint sub">@_ollamaNote</span>
                        }
                    </div>
                    <p class="hint sub">
                        <Icon Name="monitor" />
                        @L.M(Host.ReachesLocalServices ? "home.hint.ollama.native" : "home.hint.ollama")
                    </p>
                    break;
            }

            <div class="key-row">
                <button class="ghost" @onclick="SaveSettings">@L["common.save"]</button>
                <button class="ghost" @onclick="ForgetSettings">@L["home.forget"]</button>
                @if (_settingsSaved) { <span class="saved-note"><Icon Name="check" /> @L["home.saved"]</span> }
            </div>
        </div>
    }
</section>

@if (_result is not null)
{
    var r = _result;
    <section class="results">
        <div class="summary card">
            <div class="score-ring @ScoreClass(r.OverallScore)"
                 style="--pct:@r.OverallScore.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                <div class="score-inner">
                    <span class="score-num">@Math.Round(r.OverallScore)</span>
                    <span class="score-of">/100</span>
                </div>
            </div>
            <div class="verdict">
                <h2 class="@ScoreClass(r.OverallScore)">@L.Verdict(r.OverallScore)</h2>
                <p>@L.P(r.Signals.Count, "home.signals") · @L["home.analyzedas"]
                    <strong>@L.TextLanguageName(r.Language)</strong></p>
                <div class="cat-chips">
                    @foreach (var c in r.CategoryScores.Where(c => c.FindingCount > 0))
                    {
                        <span class="chip chip-@Highlighter.CategoryClass(c.Category)">
                            @L.Category(c.Category) <b>@c.FindingCount</b>
                        </span>
                    }
                </div>
                <div class="summary-actions">
                    <button class="primary rewrite-btn @(_showRewrite ? "on" : "")" @onclick="@(() => _showRewrite = !_showRewrite)">
                        <Icon Name="wand" /> <span>@L[_showRewrite ? "home.rewrite.hide" : "home.rewrite.show"]</span>
                    </button>
                    <button class="ghost humanize-btn" @onclick="Humanize" disabled="@_humanizing">
                        @if (_humanizing) { <text>@L["home.humanizing"]</text> }
                        else { <Icon Name="sparkle" /> <span>@L["home.humanize"]</span> }
                    </button>
                    <button class="ghost" @onclick="ShowCard"><Icon Name="image" /> @L["home.sharecard"]</button>
                </div>
            </div>
        </div>

        @if (_showCard)
        {
            <div class="card share-preview">
                <div class="humanized-head">
                    <h3>@L["home.sharecard.h"]</h3>
                    <div>
                        <button class="primary" @onclick="DownloadCard"><Icon Name="download" /> @L["home.downloadpng"]</button>
                        <button class="ghost" @onclick="@(() => _showCard = false)">@L["common.close"]</button>
                    </div>
                </div>
                <canvas @ref="_cardCanvas" class="share-canvas"></canvas>
            </div>
        }

        @* Sits above the statistics and below the score on purpose: it is the one thing on this page
           that is checkable rather than arguable, so it should be read before the numbers. Renders
           nothing at all when the document is ordinary, which is nearly always. *@
        <ArtifactPanel Report="r.Artifacts" />

        @* Same reasoning, the other kind of fact: what the document says about its own
           sources. Renders nothing unless there are references or citations. *@
        <CitationPanel Report="r.Citations" />

        <div class="stats card">
            <div class="stat"><span class="stat-label">@L["home.stat.words"]</span><span class="stat-val">@r.Statistics.WordCount</span></div>
            <div class="stat"><span class="stat-label">@L["home.stat.sentences"]</span><span class="stat-val">@r.Statistics.SentenceCount</span></div>
            <div class="stat"><span class="stat-label">@L["home.stat.avglen"]</span><span class="stat-val">@r.Statistics.MeanSentenceLength</span></div>
            <div class="stat" title="@L["home.stat.burstiness.title"]">
                <span class="stat-label">@L["home.stat.burstiness"]</span>
                <span class="stat-val @(r.Statistics.Burstiness < 0.45 && r.Statistics.SentenceCount >= 4 ? "warn" : "")">
                    @r.Statistics.Burstiness.ToString("0.00")
                </span>
            </div>
            <div class="stat"><span class="stat-label">@L["home.stat.diversity"]</span><span class="stat-val">@r.Statistics.LexicalDiversity.ToString("0.00")</span></div>
        </div>

        @if (_showRewrite)
        {
            <LiveRewritePanel Text="@_analyzedText" Result="r" ExtraPacks="Catalogs.EnabledPacks()"
                              OnUseAsInput="UseRewritten" />
        }

        <div class="rhythm card">
            <h3>@L["home.rhythm"]</h3>
            <p class="hint">@L.M("home.rhythm.hint")</p>
            <RhythmChart Stats="r.Statistics" />
        </div>

        <PerplexityPanel Text="@_text" Language="@r.Language" />

        @if (_humanizeError is not null)
        {
            <div class="card humanize-error"><Icon Name="alert" /> @_humanizeError</div>
        }
        @if (_humanized is not null)
        {
            <div class="card humanized">
                <div class="humanized-head">
                    <h3><Icon Name="sparkle" /> @L["home.humanized"]</h3>
                    <div>
                        @if (_humanizedResult is not null)
                        {
                            <span class="score-compare">
                                <span class="sc-num @ScoreClass(r.OverallScore)">@Math.Round(r.OverallScore)</span>
                                <span class="sc-arrow">→</span>
                                <span class="sc-num @ScoreClass(_humanizedResult.OverallScore)">@Math.Round(_humanizedResult.OverallScore)</span>
                                @{ var delta = r.OverallScore - _humanizedResult.OverallScore; }
                                @if (delta > 0.5) { <span class="sc-delta">−@Math.Round(delta)</span> }
                            </span>
                        }
                        <button class="ghost" @onclick="CopyHumanized">@L["common.copy"]</button>
                        <button class="ghost" @onclick="ReanalyzeHumanized">@L["home.useasinput"]</button>
                    </div>
                </div>
                @if (_diff is not null)
                {
                    <div class="diff-grid">
                        <div class="diff-col">
                            <h4>@L["home.original"]</h4>
                            <div class="text-view diff-view">
                                @foreach (var seg in _diff.Where(s => s.Kind != DiffKind.Added))
                                {
                                    <span class="@(seg.Kind == DiffKind.Removed ? "d-del" : "")">@seg.Text </span>
                                }
                            </div>
                        </div>
                        <div class="diff-col">
                            <h4>@L["home.humanized"]</h4>
                            <div class="text-view diff-view">
                                @foreach (var seg in _diff.Where(s => s.Kind != DiffKind.Removed))
                                {
                                    <span class="@(seg.Kind == DiffKind.Added ? "d-add" : "")">@seg.Text </span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        <div class="workspace">
            <div class="annotated card">
                <h3>@L["home.annotated"]</h3>
                <p class="hint">@L["home.annotated.hint"]</p>
                <div class="text-view">
                    @foreach (var seg in Highlighter.Build(_analyzedText, r.Findings))
                    {
                        if (seg.Finding is { } f)
                        {
                            <mark class="hl hl-@Highlighter.CategoryClass(f.Category)"
                                  title="@f.Message&#10;→ @f.Suggestion">@seg.Text</mark>
                        }
                        else
                        {
                            @seg.Text
                        }
                    }
                </div>
            </div>

            <div class="findings card">
                <h3>@L.F("home.recommendations", r.Signals.Count)</h3>
                @if (r.Signals.Count == 0)
                {
                    <p class="empty"><Icon Name="check-circle" /> @L["home.nofindings"]</p>
                }
                else
                {
                    <ul class="finding-list">
                        @foreach (var f in r.Findings)
                        {
                            <li class="finding sev-@f.Severity.ToString().ToLowerInvariant()">
                                <div class="finding-head">
                                    <span class="badge badge-@Highlighter.CategoryClass(f.Category)">@L.Category(f.Category)</span>
                                    @if (!string.IsNullOrEmpty(f.MatchedText)) { <code>@f.MatchedText</code> }
                                    <span class="sev-tag">@L.Sev(f.Severity)</span>
                                </div>
                                <p class="finding-msg">@f.Message</p>
                                <p class="finding-fix"><Icon Name="lightbulb" /> @f.Suggestion</p>
                                @if (!string.IsNullOrEmpty(f.Evidence)) { <p class="finding-evidence">@f.Evidence</p> }
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </section>
}
else
{
    <p class="idle-hint">@L["home.idle"]</p>
}

@code {
    private const string SettingsStorageKey = "signsofai.humanize.v3";
    private const long MaxFileBytes = 5 * 1024 * 1024;

    private string _text = string.Empty;
    private string _language = "auto";
    private AnalysisResult? _result;
    private string _analyzedText = string.Empty;
    private string? _fileNote;

    private CancellationTokenSource? _debounceCts;

    private bool _showSettings;
    private HumanizeSettings _settings = new();
    private bool _settingsSaved;

    // Sticky across keystrokes: once the split view is open the user is working in it, so it must not
    // collapse every time the analysis re-runs.
    private bool _showRewrite;

    private bool _humanizing;
    private string? _humanized;
    private AnalysisResult? _humanizedResult;
    private IReadOnlyList<DiffSegment>? _diff;
    private string? _humanizeError;

    // Custom catalogs UI
    private bool _showCatalogs;
    private string _catMode = "words";
    private string _newCatName = string.Empty;
    private string _newCatWords = string.Empty;
    private string _newCatJson = string.Empty;
    private string? _catError;

    // Share card
    private bool _showCard;
    private bool _cardNeedsDraw;
    private ElementReference _cardCanvas;

    private int WordCount =>
        string.IsNullOrWhiteSpace(_text) ? 0
        : _text.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries).Length;

    protected override async Task OnInitializedAsync()
    {
        await Catalogs.LoadAsync();

        var stored = await Storage.GetAsync(SettingsStorageKey);
        if (!string.IsNullOrEmpty(stored))
        {
            try
            {
                _settings = JsonSerializer.Deserialize(stored, LlmJsonContext.Default.HumanizeSettings) ?? new();
                _settingsSaved = true;
            }
            catch { _settings = new(); }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_cardNeedsDraw && _showCard && _result is not null)
        {
            _cardNeedsDraw = false;
            await JS.InvokeVoidAsync("signsofai.drawCard", _cardCanvas, BuildCardJson(_result));
        }
    }

    private async Task OnTextChanged()
    {
        _fileNote = null;
        _debounceCts?.Cancel();
        var cts = _debounceCts = new CancellationTokenSource();
        try { await Task.Delay(350, cts.Token); }
        catch (TaskCanceledException) { return; }
        if (cts.IsCancellationRequested) return;

        RunAnalysis();
        StateHasChanged();
    }

    private void OnControlChanged()
    {
        if (!string.IsNullOrWhiteSpace(_text)) RunAnalysis();
    }

    private void RunAnalysis()
    {
        if (string.IsNullOrWhiteSpace(_text))
        {
            _result = null;
            _analyzedText = string.Empty;
            ResetHumanize();
            _showCard = false;
            return;
        }
        _analyzedText = _text;
        _result = Analyzer.Analyze(_text, _language, Catalogs.EnabledPacks());
        ResetHumanize();
        _showCard = false;
    }

    private void ResetHumanize()
    {
        _humanized = null;
        _humanizedResult = null;
        _diff = null;
        _humanizeError = null;
    }

    // ── Ollama model discovery ───────────────────────────────────────────────
    private string[] _ollamaModels = [];
    private string? _ollamaNote;
    private bool _ollamaBusy;

    private async Task DetectOllamaModels()
    {
        _ollamaBusy = true;
        _ollamaNote = null;
        try
        {
            var (models, error) = await Humanizer.ListOllamaModelsAsync(_settings.OllamaBaseUrl);
            _ollamaModels = [.. models];
            _ollamaNote = error ?? L.F("home.ollama.found", models.Count);

            // One model installed is the common case; picking it saves a step and cannot be wrong.
            if (models.Count == 1 && string.IsNullOrWhiteSpace(_settings.Model))
                _settings.Model = models[0];
        }
        finally
        {
            _ollamaBusy = false;
        }
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;
        if (file.Size > MaxFileBytes)
        {
            _fileNote = L.F("file.toolarge", file.Name);
            return;
        }
        try
        {
            // Which formats are on offer is the host's call — the browser build reads Word and plain
            // text, the desktop build also reads PDF, ODT, EPUB and RTF. See IDocumentReader.
            await using var stream = file.OpenReadStream(MaxFileBytes);
            var read = await Reader.ReadAsync(stream, file.Name, MaxFileBytes);
            _text = read.Text;

            RunAnalysis();
            _fileNote = read.Warning is null
                ? L.F("file.loaded", file.Name, file.Size / 1024)
                : L.F("file.loaded.warned", file.Name, file.Size / 1024, read.Warning);
        }
        catch (Exception ex)
        {
            _fileNote = L.F("file.error", ex.Message);
        }
    }

    private void Clear()
    {
        _text = string.Empty;
        RunAnalysis();
        _fileNote = null;
    }

    private void LoadSample(string sample)
    {
        _text = sample;
        _fileNote = null;
        RunAnalysis();
    }

    private async Task SaveSettings()
    {
        var json = JsonSerializer.Serialize(_settings, LlmJsonContext.Default.HumanizeSettings);
        await Storage.SetAsync(SettingsStorageKey, json);
        _settingsSaved = true;
    }

    private async Task ForgetSettings()
    {
        await Storage.RemoveAsync(SettingsStorageKey);
        _settings = new();
        _settingsSaved = false;
    }

    // ── custom catalogs ─────────────────────────────────────────────
    private async Task AddBannedWords()
    {
        await Catalogs.AddBannedWordsAsync(_newCatName, _newCatWords, "*");
        _newCatName = _newCatWords = string.Empty;
        RunAnalysis(); // apply live
    }

    private async Task AddJsonCatalog()
    {
        _catError = null;
        try
        {
            await Catalogs.AddJsonAsync(_newCatName, _newCatJson, "");
            _newCatName = _newCatJson = string.Empty;
            RunAnalysis();
        }
        catch (Exception ex) { _catError = L.F("home.cat.invalid", ex.Message); }
    }

    private async Task ToggleCatalog(CustomCatalog c) { await Catalogs.ToggleAsync(c); RunAnalysis(); }
    private async Task RemoveCatalog(CustomCatalog c) { await Catalogs.RemoveAsync(c); RunAnalysis(); }

    private async Task DownloadTemplate() =>
        await JS.InvokeVoidAsync("signsofai.downloadText", "signsofai-en-template.json", RulePackLoader.Load("en").ToJson());

    // ── humanize ────────────────────────────────────────────────────
    private async Task Humanize()
    {
        if (_result is null) return;
        if (!_settings.IsConfigured())
        {
            _showSettings = true;
            _humanizeError = L["home.humanize.configure"];
            return;
        }

        _humanizing = true;
        ResetHumanize();
        StateHasChanged();

        var result = await Humanizer.HumanizeAsync(_analyzedText, _result.Language, _result.Findings, _settings);
        _humanizing = false;
        if (result.Success)
        {
            _humanized = result.Text;
            _humanizedResult = Analyzer.Analyze(_humanized, _language, Catalogs.EnabledPacks());
            _diff = WordDiff.Compute(_analyzedText, _humanized);
        }
        else _humanizeError = L.F("home.humanize.failed", result.Error ?? "");
    }

    private async Task CopyHumanized()
    {
        if (_humanized is not null)
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _humanized);
    }

    private void ReanalyzeHumanized()
    {
        if (_humanized is null) return;
        _text = _humanized;
        _fileNote = null;
        RunAnalysis();
    }

    /// <summary>Pull the locally-rewritten text back into the editor and score it for real.</summary>
    private void UseRewritten(string rewritten)
    {
        if (string.IsNullOrWhiteSpace(rewritten)) return;
        _text = rewritten;
        _fileNote = null;
        RunAnalysis();
    }

    // ── share card ──────────────────────────────────────────────────
    private void ShowCard()
    {
        _showCard = true;
        _cardNeedsDraw = true;
    }

    private async Task DownloadCard() =>
        await JS.InvokeVoidAsync("signsofai.downloadCanvas", _cardCanvas, "signsofai-score.png");

    // Not static: the card is drawn in the reader's interface language, so it needs the localizer.
    private string BuildCardJson(AnalysisResult r)
    {
        var data = new ShareCardData(
            Score: r.OverallScore,
            ScoreColor: ScoreHex(r.OverallScore),
            Verdict: L.Verdict(r.OverallScore),
            Signals: r.Signals.Count,
            Language: L.TextLanguageName(r.Language),
            Categories: r.CategoryScores.Where(c => c.FindingCount > 0)
                .Select(c => new CardCategory(L.Category(c.Category), c.FindingCount, Highlighter.CategoryHex(c.Category)))
                .ToArray(),
            Words: r.Statistics.WordCount,
            Sentences: r.Statistics.SentenceCount,
            Burstiness: r.Statistics.Burstiness.ToString("0.00"),
            Lengths: r.Statistics.SentenceLengths.ToArray());
        return JsonSerializer.Serialize(data, ShareCardJsonContext.Default.ShareCardData);
    }

    private static string ScoreClass(double score) => score switch
    {
        >= 70 => "danger",
        >= 45 => "warn",
        >= 20 => "notice",
        _ => "good",
    };

    private static string ScoreHex(double score) => score switch
    {
        >= 70 => "#dc2626",
        >= 45 => "#ea580c",
        >= 20 => "#ca8a04",
        _ => "#16a34a",
    };

