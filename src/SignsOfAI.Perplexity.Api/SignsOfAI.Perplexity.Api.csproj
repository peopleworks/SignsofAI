<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Publish only the win-x64 native binaries (ORT ships natives for every OS ≈ 200MB otherwise),
         framework-dependent so the .NET runtime isn't bundled. Also fixes native-dll resolution under IIS. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- Tokenizers ships host-specific native binaries. Every host that consumes SignsOfAI.Onnx
         must reference the runtime package for its own RID. This API host targets Windows x64. -->
    <PackageReference Include="Tokenizers.DotNet.runtime.win-x64" Version="1.4.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SignsOfAI.Onnx\SignsOfAI.Onnx.csproj" />
  </ItemGroup>

</Project>
