@inherits LocalizedComponent
@inject PerplexityClient Perplexity
@inject BrowserStorage Storage

<div class="ppl card">
    <div class="ppl-head">
        <h3>@L["ppl.h"] <span class="badge-beta">@L["ppl.beta"]</span></h3>
        <button class="ppl-gear icon-btn" title="@L["ppl.gear.title"]" @onclick="() => _showSettings = !_showSettings"><Icon Name="settings" /></button>
    </div>
    <p class="hint">@L.M("ppl.hint")</p>

    @if (_showSettings || !_settings.IsConfigured)
    {
        <div class="ppl-settings">
            <label class="ppl-field">
                <span>@L["ppl.url.label"]</span>
                <input type="url" placeholder="@L["ppl.url.ph"]" @bind="_endpointEdit" @bind:event="oninput" />
            </label>
            <div class="ppl-settings-actions">
                <button class="primary" @onclick="SaveEndpoint" disabled="@(string.IsNullOrWhiteSpace(_endpointEdit))">@L["common.save"]</button>
                @if (_settings.IsConfigured)
                {
                    <span class="ppl-ok"><Icon Name="check" /> @L.F("ppl.connected", DisplayHost(_settings.Endpoint))</span>
                }
            </div>
            <p class="ppl-privacy">
                <Icon Name="lock" /> @L.M("ppl.privacy")
            </p>
        </div>
    }

    @if (_settings.IsConfigured)
    {
        @if (_models.Length > 1)
        {
            <div class="ppl-models" role="group" aria-label="@L["ppl.model.aria"]">
                @foreach (var m in _models)
                {
                    <button class="ppl-model-btn @(m.Id == _selectedModel ? "sel" : "")"
                            title="@m.Note" @onclick="() => SelectModel(m.Id)">
                        @m.Label<span>@m.Note</span>
                    </button>
                }
            </div>
        }
        <button class="primary ppl-run" @onclick="Measure"
                disabled="@(_loading || string.IsNullOrWhiteSpace(Text))">
            @(_loading ? L["ppl.measuring"] : L["ppl.measure"])
        </button>
    }

    @if (_error is not null)
    {
        <div class="ppl-error"><Icon Name="alert" /> @_error</div>
    }

    @if (_result is not null)
    {
        var r = _result;
        var pct = (int)Math.Round(r.Predictability * 100);
        <div class="ppl-result">
            <div class="ppl-verdict @BandClass(r.Band)">
                <span class="ppl-verdict-label">@BandLabel(r.Band)</span>
                <span class="ppl-verdict-pct">@pct<small>@L["ppl.pct"]</small></span>
            </div>
            <div class="ppl-meter" title="@L["ppl.meter.title"]">
                <div class="ppl-meter-fill @BandClass(r.Band)" style="width:@(pct)%"></div>
            </div>
            <p class="ppl-note">@BandNote(r.Band)</p>
            <div class="ppl-nums">
                <div class="ppl-num"><span>@L["ppl.num.ppl"]</span><strong>@r.Ppl.ToString("0.0")</strong></div>
                <div class="ppl-num"><span>@L["ppl.num.tokens"]</span><strong>@r.TokenCount</strong></div>
                <div class="ppl-num"><span>@L["ppl.num.model"]</span><strong class="ppl-model">@r.Model</strong></div>
                <div class="ppl-num"><span>@L["ppl.num.time"]</span><strong>@r.ElapsedMs ms</strong></div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string Text { get; set; } = "";
    [Parameter] public string Language { get; set; } = "auto";

    private PerplexitySettings _settings = new();
    private string _endpointEdit = "";
    private bool _showSettings;
    private bool _loading;
    private string? _error;
    private PerplexityResult? _result;
    private CancellationTokenSource? _cts;
    private PerplexityModelInfo[] _models = [];
    private string? _selectedModel;

    protected override async Task OnInitializedAsync()
    {
        _settings = await Perplexity.LoadSettingsAsync(Storage);
        _endpointEdit = _settings.Endpoint;
        if (_settings.IsConfigured)
        {
            // Pre-warm the default model while the user reads their results, so "Measure" is warm.
            _ = Perplexity.WarmupAsync(_settings.Endpoint);
            _models = await Perplexity.GetModelsAsync(_settings.Endpoint);
            _selectedModel = (_models.FirstOrDefault(m => m.IsDefault) ?? _models.FirstOrDefault())?.Id;
        }
    }

    private void SelectModel(string id)
    {
        if (id == _selectedModel) return;
        _selectedModel = id;
        _result = null; _error = null;
        // Warm the newly-picked model (esp. the heavier Phi) while the user reads / clicks.
        _ = Perplexity.WarmupAsync(_settings.Endpoint, id);
    }

    private async Task SaveEndpoint()
    {
        _settings = _settings with { Endpoint = _endpointEdit.Trim() };
        await Perplexity.SaveSettingsAsync(Storage, _settings);
        _showSettings = false;
        _error = null;
        _models = await Perplexity.GetModelsAsync(_settings.Endpoint);
        _selectedModel = (_models.FirstOrDefault(m => m.IsDefault) ?? _models.FirstOrDefault())?.Id;
    }

    private async Task Measure()
    {
        if (string.IsNullOrWhiteSpace(Text) || !_settings.IsConfigured) return;
        _cts?.Cancel();
        _cts = new CancellationTokenSource();
        _loading = true; _error = null;
        try
        {
            _result = await Perplexity.MeasureAsync(_settings.Endpoint, Text, Language, _selectedModel, _cts.Token);
        }
        catch (OperationCanceledException) { /* superseded */ }
        catch (Exception ex)
        {
            _error = ex.Message.Contains("Failed to fetch") || ex.Message.Contains("HttpRequestException")
                ? L["ppl.error.unreachable"]
                : ex.Message;
        }
        finally { _loading = false; }
    }

    private static string BandClass(string b) => b switch
    {
        "very-predictable" => "b-pred",  // amber — generic phrasing (common in AI)
        "varied" => "b-var",             // green — surprising phrasing
        _ => "b-typ",                    // neutral
    };

    private string BandLabel(string b) => b switch
    {
        "very-predictable" => L["ppl.band.pred"],
        "varied" => L["ppl.band.varied"],
        _ => L["ppl.band.typical"],
    };

    private string BandNote(string b) => b switch
    {
        "very-predictable" => L["ppl.note.pred"],
        "varied" => L["ppl.note.varied"],
        _ => L["ppl.note.typical"],
    };

    private static string DisplayHost(string url)
    {
        try { return new Uri(url).Host; } catch { return url; }
    }
}
