<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.6" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.6" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- This project is now only the *host*: index.html, the icons, the deployment config and the
         WASM bootstrap. Every page, component and service lives in SignsOfAI.UI, which the desktop
         app renders too; Core arrives through it. -->
    <ProjectReference Include="..\SignsOfAI.UI\SignsOfAI.UI.csproj" />
  </ItemGroup>

</Project>
